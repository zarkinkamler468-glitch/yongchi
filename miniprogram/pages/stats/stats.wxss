.page { padding: 24rpx; }
.stat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.stat {
  flex: 1; min-width: 300rpx;
  background: rgba(255,255,255,0.86); border-radius: 20rpx;
  padding: 24rpx; box-shadow: 0 8rpx 24rpx rgba(30,41,59,0.06);
}
.stat-label { font-size: 24rpx; color: #64748b; }
.stat-value { font-size: 38rpx; font-weight: 800; margin-top: 8rpx; color: #1e293b; }

.card { margin-bottom: 24rpx; }
.card-title { font-size: 28rpx; font-weight: 700; margin-bottom: 20rpx; }

.chart { display: flex; align-items: flex-end; gap: 8rpx; height: 220rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bar-wrap { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; }
.bar { width: 60%; border-radius: 8rpx 8rpx 0 0; min-height: 4rpx; background: linear-gradient(180deg, #0ea5e9, #2563eb); }
.bar-label { font-size: 18rpx; color: #94a3b8; margin-top: 8rpx; }

.hb-row { display: flex; align-items: center; gap: 16rpx; margin: 16rpx 0; }
.hb-label { width: 120rpx; font-size: 24rpx; flex-shrink: 0; }
.hb-track { flex: 1; height: 28rpx; background: #eef1f6; border-radius: 8rpx; overflow: hidden; }
.hb-fill { height: 100%; border-radius: 8rpx; }
.hb-val { width: 140rpx; text-align: right; font-size: 26rpx; font-weight: 700; }
.empty { text-align: center; color: #94a3b8; padding: 40rpx 0; font-size: 24rpx; }
