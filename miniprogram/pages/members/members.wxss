.page { padding: 24rpx; }
.search-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search-input { flex: 1; }
.type-picker { width: 200rpx; flex-shrink: 0; }

.member-list { display: flex; flex-direction: column; gap: 16rpx; }
.member-card {
  background: rgba(255,255,255,0.86); border-radius: 24rpx; padding: 26rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(30,41,59,0.06);
}
.member-head { display: flex; align-items: center; justify-content: space-between; }
.member-name { font-size: 32rpx; font-weight: 700; }
.gender { font-size: 22rpx; color: #64748b; margin-left: 8rpx; font-weight: 400; }
.member-no { font-size: 24rpx; color: #64748b; margin: 8rpx 0 16rpx; }
.member-foot { display: flex; align-items: center; justify-content: space-between; }
.member-tags { font-size: 24rpx; color: #2563eb; max-width: 420rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.member-cards { font-size: 24rpx; color: #64748b; }
.empty { text-align: center; color: #94a3b8; padding: 80rpx 0; font-size: 26rpx; }
