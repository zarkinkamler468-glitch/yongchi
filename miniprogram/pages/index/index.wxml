<view class="page">
  <view class="hero">
    <view class="hero-title">你好，{{user.name || ''}}</view>
    <view class="hero-sub">今日营业概览{{stats && stats.shift_started ? '' : ' · 班次未开始'}}</view>
  </view>
  <view class="shift-reminder" wx:if="{{showShiftReminder}}">
    <view class="shift-reminder-main"><view class="shift-reminder-title">今日班次尚未开始</view><view class="shift-reminder-desc">开班后，收银、退款会自动归入本班，交班时可核对现金。</view></view>
    <view class="shift-reminder-actions"><button class="shift-later" bindtap="dismissShiftReminder">稍后</button><button class="shift-start" bindtap="startShift" loading="{{startingShift}}">开始班次</button></view>
  </view>

  <view class="stat-grid" wx:if="{{stats}}">
    <view class="stat"><view class="stat-label">今日收入</view><view class="stat-value num">{{stats.today_income}}</view></view>
    <view class="stat"><view class="stat-label">开卡/续费/充值</view><view class="stat-value num" style="font-size:28rpx">{{stats.today_open}}/{{stats.today_renew}}/{{stats.today_recharge}}</view></view>
    <view class="stat"><view class="stat-label">退款 / 入场</view><view class="stat-value num" style="font-size:28rpx">{{stats.today_refund}} / {{stats.today_entries}}</view></view>
    <view class="stat"><view class="stat-label">到期/低余额/黑名单</view><view class="stat-value num" style="font-size:28rpx">{{stats.expiring_cards}}/{{stats.low_balance_members}}/{{stats.blacklist_count}}</view></view>
  </view>

  <view class="quick">
    <view class="quick-item" bindtap="goCashier"><view class="quick-ico qi-cash"></view><text>收银</text></view>
    <view class="quick-item" bindtap="goCheckin"><view class="quick-ico qi-check"></view><text>核销</text></view>
    <view class="quick-item" bindtap="goMembers"><view class="quick-ico qi-member"></view><text>会员</text></view>
    <view class="quick-item" bindtap="goShifts"><view class="quick-ico qi-shift"></view><text>交班</text></view>
  </view>

  <view class="card">
    <view class="card-title">近 14 天收入趋势</view>
    <view class="chart">
      <view class="bar-col" wx:for="{{recent}}" wx:key="date">
        <view class="bar-wrap"><view class="bar" style="height: {{item.h}}%"></view></view>
        <view class="bar-label">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>
