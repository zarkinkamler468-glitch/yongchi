<view class="page">
  <view class="card user-card">
    <view class="avatar">泳</view>
    <view class="user-info">
      <view class="user-name">{{user.name}}</view>
      <view class="user-role">{{roleText}}<text class="wx-badge {{wxBound ? '' : 'off'}}">{{wxBound ? '已绑微信' : '未绑微信'}}</text></view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goStats"><text class="menu-ico">▥</text><text class="menu-label">营收统计</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="goOrders"><text class="menu-ico">≡</text><text class="menu-label">收银流水</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="goShifts"><text class="menu-ico">◷</text><text class="menu-label">交班对账</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" wx:if="{{canRefund}}" bindtap="goRefunds"><text class="menu-ico">↩</text><text class="menu-label">退款审批</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" wx:if="{{wxBound}}" bindtap="unbindWx"><text class="menu-ico">⌁</text><text class="menu-label">解绑微信</text><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="logout"><text class="menu-ico">⇥</text><text class="menu-label">退出登录</text><text class="menu-arrow">›</text></view>
  </view>

  <view class="foot">峡谷管理系统 · 小程序 v0.5</view>
  <view class="beian" wx:if="{{icpNo || pseNo}}">
    <view wx:if="{{icpNo}}">{{icpNo}}</view>
    <view wx:if="{{pseNo}}">{{pseNo}}</view>
  </view>
</view>
