.page { padding: 24rpx; }
.user-card { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; background: linear-gradient(135deg, #2563eb, #0ea5e9);
}
.user-name { font-size: 34rpx; font-weight: 700; }
.user-role { font-size: 24rpx; color: #64748b; margin-top: 6rpx; }
.wx-badge { display: inline-block; margin-left: 12rpx; padding: 2rpx 14rpx; border-radius: 999rpx; font-size: 20rpx; background: rgba(16,185,129,0.15); color: #047857; }
.wx-badge.off { background: rgba(100,116,139,0.15); color: #475569; }

.menu { background: rgba(255,255,255,0.86); border-radius: 24rpx; overflow: hidden; box-shadow: 0 8rpx 24rpx rgba(30,41,59,0.06); }
.menu-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 30rpx 28rpx; border-bottom: 1rpx solid rgba(15,23,42,0.05);
}
.menu-item:last-child { border-bottom: none; }
.menu-ico { width: 36rpx; height: 36rpx; flex: 0 0 36rpx; font-size: 36rpx; line-height: 36rpx; position: relative; color: #334155; }
.icon-refund::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 8rpx;
  width: 21rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-left-color: transparent;
  border-radius: 50%;
  transform: rotate(-12deg);
  box-sizing: border-box;
}
.icon-refund::after {
  content: '';
  position: absolute;
  left: 3rpx;
  top: 7rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}
.menu-label { flex: 1; font-size: 28rpx; }
.menu-arrow { font-size: 40rpx; color: #cbd5e1; }

.foot { text-align: center; color: #94a3b8; font-size: 22rpx; margin-top: 60rpx; }
.beian { text-align: center; color: #94a3b8; font-size: 20rpx; line-height: 1.8; margin-top: 12rpx; padding-bottom: 30rpx; }
.pending-item { margin-bottom: 20rpx; font-size: 26rpx; line-height: 1.6; }
.pending-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
