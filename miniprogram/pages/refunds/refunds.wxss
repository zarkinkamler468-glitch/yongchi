.page { padding: 24rpx; }
.card-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.rf-row { padding: 20rpx 0; border-bottom: 1rpx solid rgba(15,23,42,0.05); }
.rf-row:last-child { border-bottom: none; }
.rf-head { display: flex; justify-content: space-between; align-items: center; }
.rf-no { font-weight: 700; font-size: 28rpx; }
.rf-amt { font-size: 30rpx; font-weight: 800; color: #dc2626; }
.rf-sub { font-size: 24rpx; color: #64748b; margin: 8rpx 0 14rpx; }
.rf-actions { display: flex; gap: 16rpx; }
.rf-btn { flex: 1; height: 72rpx; font-size: 26rpx; }
.empty { text-align: center; color: #94a3b8; padding: 40rpx 0; font-size: 24rpx; }
