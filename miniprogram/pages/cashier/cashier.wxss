.page { padding: 24rpx; }
.cashier-home { padding-top: 28rpx; }
.page-head, .form-head { margin: 10rpx 8rpx 28rpx; }
.page-kicker { color:#2563eb; font-size:22rpx; font-weight:700; letter-spacing:2rpx; }
.page-title { color:#172033; font-size:40rpx; font-weight:800; margin-top:6rpx; }
.page-desc { color:#64748b; font-size:24rpx; margin-top:10rpx; }
.quick-sales { display:flex; flex-direction:column; gap:18rpx; }
.sales-action { background:rgba(255,255,255,.9); border:1rpx solid rgba(37,99,235,.08); border-radius:24rpx; padding:30rpx; box-shadow:0 12rpx 34rpx rgba(30,41,59,.08); position:relative; }
.line-icon { width:68rpx; height:68rpx; border:3rpx solid #2563eb; color:#2563eb; border-radius:20rpx; display:flex; align-items:center; justify-content:center; font-size:42rpx; line-height:1; margin-bottom:18rpx; position:relative; box-sizing:border-box; }
.icon-checkin { border-radius:50%; }
.icon-checkin::before { content:''; position:absolute; width:24rpx; height:13rpx; left:18rpx; top:22rpx; border-left:4rpx solid currentColor; border-bottom:4rpx solid currentColor; transform:rotate(-45deg); }
.icon-checkin::after { content:''; position:absolute; width:12rpx; height:12rpx; right:-5rpx; top:-5rpx; border-radius:50%; background:#0ea5e9; border:4rpx solid #fff; }
.sales-title { font-size:32rpx; font-weight:800; color:#172033; }
.sales-desc { font-size:24rpx; color:#64748b; margin-top:8rpx; }
.form-head { display:flex; align-items:center; gap:14rpx; }
.back { width:60rpx; height:60rpx; border-radius:18rpx; background:#fff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:52rpx; line-height:1; box-shadow:0 6rpx 18rpx rgba(30,41,59,.08); }
.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.tab {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx;
  background: rgba(255,255,255,0.85); font-weight: 600; color: #475569;
}
.tab.active { background: #2563eb; color: #fff; }
.card { margin-bottom: 20rpx; }
.row { display: flex; }
.pays { display: flex; gap: 12rpx; }
.pay { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 14rpx; background: #f1f5f9; font-weight: 600; color: #475569; }
.pay.active { background: #2563eb; color: #fff; }
.total-row { display: flex; justify-content: space-between; align-items: baseline; margin: 20rpx 0 12rpx; color: #64748b; }
.total-row text:last-child { font-size: 44rpx; font-weight: 800; color: #1e293b; }
.big { font-size: 40rpx; font-weight: 700; }
.member-search { position:relative; }
.member-search .input { padding-right:70rpx; }
.search-mark { position:absolute; right:22rpx; top:18rpx; color:#2563eb; font-size:36rpx; }
.selected-hint { color:#2563eb; font-size:24rpx; margin-top:10rpx; }
.new-member-link { color:#2563eb; font-size:24rpx; margin-top:14rpx; }
.picker-mask { position:fixed; inset:0; z-index:95; background:rgba(15,23,42,.4); }
.member-sheet { position:fixed; left:24rpx; right:24rpx; bottom:24rpx; max-height:75vh; overflow:auto; z-index:96; background:#fff; border-radius:26rpx; padding:28rpx; }
.member-option { padding:24rpx 8rpx; border-bottom:1rpx solid #eef2f7; color:#172033; }
.member-option text { display:block; color:#94a3b8; font-size:22rpx; margin-top:5rpx; }
.member-option.new { color:#2563eb; font-weight:700; }
.result-card { margin-top:20rpx; }
.result-ok { color:#047857; font-weight:700; }
.result-fail { color:#b91c1c; font-weight:700; }
