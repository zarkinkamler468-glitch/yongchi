/* 全局样式 */
page {
  --primary: #2563eb;
  --primary-2: #0ea5e9;
  --text: #1e293b;
  --muted: #64748b;
  background: linear-gradient(160deg, #f6f9ff 0%, #eef2fb 50%, #f4f1fb 100%);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, input { box-sizing: border-box; }

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(30, 41, 59, 0.08);
  padding: 24rpx;
}

/* 主按钮 */
.btn {
  display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx; font-weight: 600; font-size: 28rpx;
  padding: 0 28rpx; height: 80rpx; line-height: 1;
  border: none;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(135deg, #2563eb, #0ea5e9);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.28);
}
.btn-success { background: linear-gradient(135deg, #059669, #10b981); color: #fff; }
.btn-danger { background: linear-gradient(135deg, #dc2626, #ef4444); color: #fff; }
.btn-ghost { background: rgba(255,255,255,0.7); color: var(--text); border: 1rpx solid rgba(15,23,42,0.08); }
.btn-disabled { opacity: 0.55; }

/* 徽章 */
.badge {
  display: inline-flex; align-items: center;
  padding: 4rpx 18rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 600; line-height: 1.5;
}
.badge-blue { background: rgba(37,99,235,0.14); color: #1d4ed8; }
.badge-green { background: rgba(16,185,129,0.16); color: #047857; }
.badge-red { background: rgba(239,68,68,0.15); color: #b91c1c; }
.badge-amber { background: rgba(245,158,11,0.18); color: #b45309; }
.badge-gray { background: rgba(100,116,139,0.15); color: #475569; }

/* 表单 */
.field { margin-bottom: 24rpx; }
.field-label { font-size: 24rpx; color: #374151; font-weight: 600; margin-bottom: 10rpx; }
.input {
  background: rgba(255,255,255,0.85);
  border: 1rpx solid rgba(37,99,235,0.14);
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  height: 84rpx; line-height:84rpx; display:flex; align-items:center; box-shadow: inset 0 1rpx 2rpx rgba(15,23,42,.03), 0 5rpx 16rpx rgba(30,41,59,.04);
}
.input:focus { border-color:#2563eb; background:#fff; }
.picker {
  background: rgba(255,255,255,0.85);
  border: 1rpx solid rgba(37,99,235,0.14);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  height: 80rpx;
  display: flex; align-items: center; box-shadow: 0 5rpx 16rpx rgba(30,41,59,.04);
}

.text-muted { color: var(--muted); font-size: 24rpx; }
.num { font-variant-numeric: tabular-nums; }

/* 遮罩 */
.mask {
  position: fixed; inset: 0; z-index: 90;
  background: rgba(15, 23, 42, 0.4);
}
