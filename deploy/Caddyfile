{$DOMAIN} {
	encode zstd gzip

	# 会员导入最多 3MB；留出 base64 与请求头余量。
	request_body {
		max_size 6MB
	}

	reverse_proxy app:3000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}
