# 复制为 .env 后修改；不要提交 .env
# 域名必须已解析到本服务器，且 80/443 可从公网访问。
DOMAIN=pool.example.com

# 仅首次建库生效；至少 8 位，四个账号使用不同随机密码。
PMS_INITIAL_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PMS_INITIAL_BOSS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PMS_INITIAL_FRONTDESK_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PMS_INITIAL_FINANCE_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
